Algoritmo sin_titulo
	Escribir "Días de la semana"
	//VARIABLE
	Definir dia Como Entero
	Escribir "Digite un valor numerico entre el 1 y el 7"
	leer dia
	
	Segun dia Hacer
		1:
			Escribir "Lunes"
		2:
			Escribir "Martes"
		3:
			Escribir "Miercoles"
		4:
			Escribir "Jueves"
		5:
			Escribir "Viernes"
		6:
			Escribir "Sabado"
		7:
			Escribir "Domingo"
		De Otro Modo:
			Escribir "Digite un valor valido del 1 al 7"
	Fin Segun
FinAlgoritmo
