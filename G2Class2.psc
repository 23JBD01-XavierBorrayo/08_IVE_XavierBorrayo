Algoritmo sin_titulo
	Escribir "CLASIFICACIÓN DE LETRAS POR RANGO"
	//VARIABLE
	Definir l Como Caracter
	Escribir "Digite una letra: " sin saltar
	leer l
	
	Segun l Hacer
		"A" o "a":
			Escribir "EXCELSIOR"
		"B" o "b":
			Escribir "BUENO"
		"C" o "c":
			Escribir "REGULAR"
		"D" o "d":
			Escribir "DEFICIENTE"
		"F" o "f":
			Escribir "REPROBADO"
		De Otro Modo:
			Escribir "Digite letra valida (A, B, C, D y F)"
	Fin Segun
FinAlgoritmo
