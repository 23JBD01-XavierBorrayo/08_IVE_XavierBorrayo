	Escribir "COLOR = DGREEN, VALUE = 6"
	Escribir "COLOR = PURPLE, VALUE = 7"
	Escribir "COLOR = BLACK, VALUE = 8"
	
	Escribir "Type a number and ENJOY THE COLOR :D: "
