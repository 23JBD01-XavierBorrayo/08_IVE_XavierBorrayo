Algoritmo example4u3
	
	
	Definir c,a  Como Caracter
	
	
	Dimension c[8]
	
	c[1] = "Brown"
	c[2] = "Light_Brown"
	c[3] = "Dark_Red"
	c[4] = "Red"
	c[5] = "Yellow"
	c[6] = "Dark_Green"
	c[7] = "Purple"
	c[8] = "Black"
	
	Escribir "COLOR = BROWN, VALUE = 1"
	Escribir "COLOR = LBROWN, VALUE = 2"
	Escribir "COLOR = DRED, VALUE = 3"
	Escribir "COLOR = RED, VALUE = 4"
